# ============ 应用配置 ============
APP_NAME=AI-Powered Industrial Intelligent Maintenance Platform
APP_ENV=development
# 后端监听地址
API_HOST=0.0.0.0
API_PORT=8000
# 前端地址（用于 CORS）
FRONTEND_URL=http://localhost:3000

# ============ 数据库 ============
# 留空则默认使用 SQLite（便于本机快速启动）
# 使用 PostgreSQL 时示例：postgresql+psycopg://mcp:mcp@localhost:5432/maintenance
DATABASE_URL=
# Worker / Scheduler 使用；留空时单进程本地开发无需 Redis
REDIS_URL=

# ============ 认证 ============
# JWT 密钥，生产环境务必更换
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ AI 配置（OpenAI 兼容） ============
# 设置 AI_ENABLED=false 或留空 LLM_API_KEY 将启用 Mock AI 模式
AI_ENABLED=false
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_REQUEST_TIMEOUT_SECONDS=30

# ============ 文件存储 ============
# local 或 s3（MVP 使用 local）
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads
# S3 / OSS / MinIO 扩展（可选）
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# ============ 演示数据 ============
# 启动时若数据库为空是否自动初始化演示数据
SEED_ON_STARTUP=true
