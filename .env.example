# ============ 应用配置 ============
APP_NAME=AI-Powered Industrial Intelligent Maintenance Platform
APP_ENV=development
# 后端监听地址
API_HOST=0.0.0.0
API_PORT=8000
# 前端地址（用于 CORS）
FRONTEND_URL=http://localhost:3000

# ============ 数据库 ============
# 留空则默认使用 SQLite（便于本机快速启动）
# 使用 PostgreSQL 时示例：postgresql+psycopg://mcp:mcp@localhost:5432/maintenance
DATABASE_URL=
# 仅本地开发使用；生产迁移必须由部署阶段单独执行
AUTO_MIGRATE_ON_STARTUP=true
# Worker / Scheduler 使用；留空时单进程本地开发无需 Redis
REDIS_URL=

# ============ 认证 ============
# JWT 密钥：仅供本地开发；非开发环境必须替换为至少 32 字符的随机值
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ AI 配置（OpenAI 兼容） ============
# 设置 AI_ENABLED=false 或留空 LLM_API_KEY 将启用 Mock AI 模式
AI_ENABLED=false
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_REQUEST_TIMEOUT_SECONDS=30
EQUIPMENT_COMMAND_TIMEOUT_SECONDS=300

# ============ 文件存储 ============
# local 或 s3（MVP 使用 local）
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads
# S3 / OSS / MinIO 扩展（可选）
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# ============ 演示数据 ============
# 启动时若数据库为空是否自动初始化演示数据；非开发环境必须为 false
SEED_ON_STARTUP=true

# ============ 工业协议网关（OPC UA，只读） ============
# 总开关：默认关闭，不影响既有 Mock 设备链路
GATEWAY_ENABLED=false
# mock：进程内模拟客户端（无需 asyncua / 无真实 PLC）
# opcua：真实 OPC UA 连接（软件模拟器或现场 Server）
GATEWAY_MODE=mock
# OPC UA Server 端点；留空使用各模式默认值
GATEWAY_ENDPOINT=
# 轮询周期（秒，最小 1）
GATEWAY_POLL_INTERVAL_SECONDS=5
# 通过校验的数据是否自动进入遥测/AI 链路
GATEWAY_AUTO_INGEST=true
# 节点映射配置（相对 apps/api 工作目录）
GATEWAY_MAPPING_CONFIG=configs/opcua-node-mapping.yaml
# ============ OPC UA DataChange 订阅（事件驱动，只读） ============
# 总开关：默认关闭；轮询能力保持不变并作为订阅的 fallback
GATEWAY_SUBSCRIPTION_ENABLED=false
# 采样/发布间隔（毫秒，最小 100）
GATEWAY_SUBSCRIPTION_SAMPLING_MS=1000
# 事件缓冲 debounce 窗口（毫秒，最小 100；窗口内每节点聚合为最新值）
GATEWAY_SUBSCRIPTION_DEBOUNCE_MS=1000
